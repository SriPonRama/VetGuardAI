# ==============================================================================
# VetGuard AI - Environment Configuration Example
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Cross-Origin Resource Sharing (CORS)
# Allowed frontend origin (must be exact for credentialed requests)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Docker Compose Service Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vetguardai
POSTGRES_PORT=5432

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vetguardai?schema=public"

# Authentication & JWT Configuration
# In production, use high-entropy random strings (min 32 chars): e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_placeholder
JWT_ISSUER=vetguard-api
JWT_AUDIENCE=vetguard-client
JWT_ACCESS_EXPIRES_IN=15m

# Initial Authority Account Bootstrap (used only by npm run auth:seed)
INITIAL_AUTHORITY_EMAIL=admin.authority@vetguard.test
INITIAL_AUTHORITY_PASSWORD=AdminStrongPassword123!
INITIAL_AUTHORITY_NAME="Primary Authority Administrator"
